<launch>

  <!-- USB 摄像头发布出来的 ROS topic -->
  <arg name="image_topic"
       default="/usb_cam/image_raw"/>

  <!-- ROS2 地面站 IP，需要改成实际 IP -->
  <arg name="target_ip"
       default="192.168.50.103"/>

  <!-- 视频 UDP 端口 -->
  <arg name="target_port"
       default="9696"/>

  <!-- 视频尺寸 -->
  <arg name="width"
       default="1280"/>

  <arg name="height"
       default="720"/>

  <!-- FPS -->
  <arg name="fps"
       default="24"/>

  <!-- H264 bitrate，单位 kbps -->
  <arg name="bitrate"
       default="3000"/>


  <node
      pkg="video_sender"
      type="video_sender_node"
      name="video_sender_node"
      output="screen">

    <param
        name="image_topic"
        value="$(arg image_topic)"/>

    <param
        name="target_ip"
        value="$(arg target_ip)"/>

    <param
        name="target_port"
        value="$(arg target_port)"/>

    <param
        name="width"
        value="$(arg width)"/>

    <param
        name="height"
        value="$(arg height)"/>

    <param
        name="fps"
        value="$(arg fps)"/>

    <param
        name="bitrate"
        value="$(arg bitrate)"/>

  </node>

</launch>
