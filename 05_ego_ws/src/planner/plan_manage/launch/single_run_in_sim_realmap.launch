<launch>
    <arg name="obj_num" value="10" />
    <arg name="drone_id" value="0"/>
    <arg name="map_size_x" value="40.0"/>
    <arg name="map_size_y" value="20.0"/>
    <arg name="map_size_z" value="12.0"/>
    <arg name="odom_topic" value="visual_slam/odom" />

    <!-- 读取真实FAST-LIO2建好的地图,替换掉随机森林 -->
    <node pkg="pcl_ros" type="pcd_to_pointcloud" name="map_publisher" args="/home/licq/crop_map_shifted_bin.pcd 1" output="screen">
        <remap from="cloud_pcd" to="/map_generator/global_cloud"/>
        <param name="frame_id" value="world"/>
    </node>

    <include file="$(find ego_planner)/launch/advanced_param.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="$(arg obj_num)" />
        <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
        <arg name="depth_topic" value="pcl_render_node/depth"/>
        <arg name="cloud_topic" value="pcl_render_node/cloud"/>
        <arg name="cx" value="321.04638671875"/>
        <arg name="cy" value="243.44969177246094"/>
        <arg name="fx" value="387.229248046875"/>
        <arg name="fy" value="387.229248046875"/>
        <arg name="max_vel" value="2.0" />
        <arg name="max_acc" value="6.0" />
        <arg name="planning_horizon" value="7.5" />
        <arg name="use_distinctive_trajs" value="true" />
        <arg name="flight_type" value="2" />
        <arg name="point_num" value="4" />
        <arg name="point0_x" value="-15" />
        <arg name="point0_y" value="-5" />
        <arg name="point0_z" value="7.0" />
        <arg name="point1_x" value="15.0" />
        <arg name="point1_y" value="5.0" />
        <arg name="point1_z" value="7.0" />
        <arg name="point2_x" value="-15.0" />
        <arg name="point2_y" value="5.0" />
        <arg name="point2_z" value="7.0" />
        <arg name="point3_x" value="15.0" />
        <arg name="point3_y" value="-5.0" />
        <arg name="point3_z" value="7.0" />
        <arg name="point4_x" value="0.0" />
        <arg name="point4_y" value="0.0" />
        <arg name="point4_z" value="7.0" />
    </include>

    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="position_cmd" to="drone_$(arg drone_id)_planning/pos_cmd"/>
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>

    <include file="$(find ego_planner)/launch/simulator.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="init_x_" value="-15"/>
        <arg name="init_y_" value="-5"/>
        <arg name="init_z_" value="7.0"/>
        <arg name="odometry_topic" value="$(arg odom_topic)" />
    </include>
</launch>
