<?xml version="1.0"?>
<package format="2">
  <name>sunray_tutorial</name>
  <version>0.0.0</version>
  <description>
    Official YunDrone auto-land demos, adapted for this machine:
    swarm_msgs / detection_msgs / local topic names (see ADAPT.md).
  </description>

  <maintainer email="sirui@yundrone.com">YunDrone Tech</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>swarm_msgs</depend>
  <depend>detection_msgs</depend>
</package>
